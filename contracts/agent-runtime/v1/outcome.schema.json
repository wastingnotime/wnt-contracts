{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WNT Agent Runtime outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "correlationId",
    "status",
    "summary",
    "finishedAt",
    "evidenceRefs",
    "artifactRefs"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "jobId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "format": "uuid" },
    "status": { "enum": ["succeeded", "escalated", "failed", "blocked"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "finishedAt": { "type": "string", "format": "date-time" },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "format": "uri", "maxLength": 2048 }
    },
    "artifactRefs": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "format": "uri", "maxLength": 2048 }
    },
    "escalationQuestion": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "failureReason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "blockedBy": { "type": "string", "minLength": 1, "maxLength": 2000 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "succeeded" } } },
      "then": { "properties": { "artifactRefs": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "escalated" } } },
      "then": { "required": ["escalationQuestion"] }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "required": ["failureReason"] }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } } },
      "then": { "required": ["blockedBy"] }
    }
  ]
}
