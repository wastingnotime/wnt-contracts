{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WNT Agent Runtime job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "jobType",
    "repository",
    "objective",
    "inputs",
    "authority",
    "limits",
    "successConditions",
    "escalationConditions",
    "correlationId"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "jobId": { "type": "string", "format": "uuid" },
    "jobType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$",
      "maxLength": 100
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": { "type": "string", "format": "uri", "maxLength": 2048 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "inputs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "uri"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "uri": { "type": "string", "format": "uri", "maxLength": 2048 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryWrite", "pullRequest", "productionChange"],
      "properties": {
        "repositoryWrite": { "type": "boolean" },
        "pullRequest": { "type": "boolean" },
        "productionChange": { "const": false }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRuntimeSeconds", "maxTokens", "maxCostUsd"],
      "properties": {
        "maxRuntimeSeconds": { "type": "integer", "minimum": 60, "maximum": 43200 },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "maxCostUsd": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "successConditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "escalationConditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "correlationId": { "type": "string", "format": "uuid" },
    "parentJobId": { "type": "string", "format": "uuid" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authority": {
            "properties": { "pullRequest": { "const": true } },
            "required": ["pullRequest"]
          }
        }
      },
      "then": {
        "properties": {
          "authority": {
            "properties": { "repositoryWrite": { "const": true } }
          }
        }
      }
    }
  ]
}
